# Configuração do deploy na AWS. Copie para infra/.env e preencha.
# O infra/.env NÃO vai para o git: só este modelo, sem valores, é versionado.

# 1. Credenciais do Learner Lab: AWS Details > AWS CLI > Show.
#    Cole o bloco inteiro por cima destas linhas, do jeito que ele vem.
#    Elas vencem em cerca de 4 horas: quando vencer, cole o bloco novo.
[default]
aws_access_key_id=
aws_secret_access_key=
aws_session_token=

DB_PASSWORD=

# 3. Token do Hugging Face (https://huggingface.co/settings/tokens). A conta
#    precisa ter aceitado a licença do google/gemma-3-1b-it.
HF_TOKEN=

# 4. Opcional: caminho da chave SSH (AWS Details > Download PEM).
#    Vazio = labsuser.pem na sua pasta Downloads.
SSH_KEY=

# 5. Login do administrador, a conta para entrar no site depois do deploy.
#    Recomendado: preencha com o seu e-mail e uma senha de 12 ou mais caracteres.
#    Se deixar em branco, o deploy cria admin@autoitil.local com uma senha
#    aleatória, mostrada UMA vez no fim do deploy: anote, ou perde o acesso.
ADMIN_EMAIL=
ADMIN_PASSWORD=

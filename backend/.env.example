# Copie para .env e ajuste se necessário (defaults batem com docker-compose.yml)
# `localhost` está correto ao rodar o backend diretamente na máquina host. Se o backend
# passar a rodar dentro do docker-compose (ex.: quando F0-3+ o conteinerizar), troque o
# host para o nome do serviço no compose (`db`) em vez de `localhost`.
DATABASE_URL=postgresql+psycopg://autoitil:autoitil@localhost:5432/autoitil

# S3 / MinIO
AWS_ACCESS_KEY_ID=autoitil
AWS_SECRET_ACCESS_KEY=autoitil123
AWS_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=autoitil-uploads

# Autenticação — segredo de assinatura dos JWT (ver app.config.settings).
# Default só serve para dev local; TROQUE em qualquer ambiente além da
# máquina do desenvolvedor.
JWT_SECRET_KEY=dev-local-only-change-me

# Origens autorizadas a chamar a API de um browser diferente do frontend
# deste projeto (CORS), separadas por vírgula. Vazio = nenhuma liberada.
CORS_ALLOWED_ORIGINS=

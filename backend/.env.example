# Copie para .env e preencha os valores entre < >.
# Use os MESMOS valores do .env da raiz (docker-compose.yml).
# `localhost` está correto ao rodar o backend diretamente na máquina host. Se o backend
# rodar dentro do docker-compose, troque o host para o nome do serviço (`db`).
DATABASE_URL=postgresql+psycopg://autoitil:<POSTGRES_PASSWORD>@localhost:5432/autoitil

# S3 / MinIO
AWS_ACCESS_KEY_ID=autoitil
AWS_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
AWS_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=autoitil-uploads

# Autenticação — segredo de assinatura dos JWT (ver app.config.settings).
# Gere um valor aleatório, por exemplo: openssl rand -hex 32
JWT_SECRET_KEY=<JWT_SECRET_KEY>

# Origens autorizadas a chamar a API de um browser diferente do frontend
# deste projeto (CORS), separadas por vírgula. Vazio = nenhuma liberada.
CORS_ALLOWED_ORIGINS=

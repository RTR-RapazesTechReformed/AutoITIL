# Copie para .env na raiz e preencha os valores entre < >.
# Para gerar segredos aleatórios: openssl rand -hex 32
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
MINIO_ROOT_PASSWORD=<MINIO_ROOT_PASSWORD>
JWT_SECRET_KEY=<JWT_SECRET_KEY>

# Só para `docker compose --profile app up --build` (modelo gemma-3-1b-it, com licença aceita)
# HF_TOKEN=<seu-token-do-huggingface>
